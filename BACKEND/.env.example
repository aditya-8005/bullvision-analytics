PORT=5000
NODE_ENV=development
NODE_VERSION=22
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin for production CORS (without trailing slash).
# In production, set to your Vercel URL e.g. https://bullvision.vercel.app
# Multiple comma-separated origins are supported: https://app.vercel.app,https://custom.com
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
# Use a server-only Secret key (sb_secret_...) or legacy service_role key.
# Do not put the anon or sb_publishable key in this variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-secret-key

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
